From 7ab2c6139dc7af302b5784cf58fca341dff92740 Mon Sep 17 00:00:00 2001
From: ccr <ccr@aciceri.dev>
Date: Sun, 13 Sep 2026 15:49:08 +0200
Subject: [PATCH 7/8] live: optional echo gate for remote input

An echo-cancelling capture makes Chrome pin output to the platform's
communication stream, whose volume ceiling is low on Android and not
reachable from a page. The only escape is capturing without cancellation,
which then needs the echo handled somewhere else.

The host already has that somewhere: the software half-duplex gate local
capture uses. Extract it as #echoGated() and let pushInput apply it on
request, through new live-ctl ops gate-on/gate-off and a setEchoGate on the
collab bridge. Default stays off, since a remote endpoint that cancels echo
itself would only lose genuine barge-in.

(cherry picked from commit 9bba643395c74a8b2806dc697331680ffbe58542)
---
 packages/coding-agent/src/collab/host.ts      | 11 ++++-
 packages/coding-agent/src/live/controller.ts  | 40 ++++++++++++++-----
 .../controllers/live-command-controller.ts    |  1 +
 packages/wire/src/index.ts                    | 14 +++++--
 4 files changed, 51 insertions(+), 15 deletions(-)

diff --git a/packages/coding-agent/src/collab/host.ts b/packages/coding-agent/src/collab/host.ts
index a9af700..fdc42b0 100644
--- a/packages/coding-agent/src/collab/host.ts
+++ b/packages/coding-agent/src/collab/host.ts
@@ -84,6 +84,8 @@ export interface CollabLiveAudioBridge {
 	/** Feeds guest microphone audio as mono 16 kHz PCM. */
 	pushInput(samples: Float32Array): void;
 	setMuted(muted: boolean): void;
+	/** Applies the host echo gate to this guest's input; see the wire `gate-on` op. */
+	setEchoGate(enabled: boolean): void;
 	stop(): Promise<void>;
 }
 
@@ -592,7 +594,10 @@ export class CollabHost {
 		this.#liveAudio = bridge;
 	}
 
-	async #handleLiveCtl(op: "claim" | "release" | "mute" | "unmute", fromPeer: number): Promise<void> {
+	async #handleLiveCtl(
+		op: "claim" | "release" | "mute" | "unmute" | "gate-on" | "gate-off",
+		fromPeer: number,
+	): Promise<void> {
 		const peer = this.#peers.get(fromPeer);
 		if (!peer?.canWrite) {
 			this.#rejectReadOnly("live audio", fromPeer);
@@ -637,6 +642,10 @@ export class CollabHost {
 			this.#broadcast({ t: "live-state", active: false });
 			return;
 		}
+		if (op === "gate-on" || op === "gate-off") {
+			bridge.setEchoGate(op === "gate-on");
+			return;
+		}
 		const muted = op === "mute";
 		bridge.setMuted(muted);
 		this.#broadcast({ t: "live-state", active: true, owner: fromPeer, muted });
diff --git a/packages/coding-agent/src/live/controller.ts b/packages/coding-agent/src/live/controller.ts
index cb3ffd6..8d1ea2c 100644
--- a/packages/coding-agent/src/live/controller.ts
+++ b/packages/coding-agent/src/live/controller.ts
@@ -124,6 +124,7 @@ export class LiveSessionController {
 	#terminalEmitted = false;
 	#failure: Error | undefined;
 	#muted = false;
+	#remoteEchoGate = false;
 	#phase: LivePhase = "connecting";
 	#inputLevel = 0;
 	#outputLevel = 0;
@@ -393,27 +394,46 @@ export class LiveSessionController {
 		if (this.#muted) return;
 		this.#inputLevel = microphoneLevel(samples);
 		this.#emitLevels();
-		// Software half-duplex gate: the local microphone hears the local
-		// speaker, so quiet input during playback is echo rather than speech.
+		if (this.#echoGated()) return;
+		this.#sendInput(samples);
+	}
+
+	/**
+	 * Software half-duplex gate: a microphone that hears the speaker rendering
+	 * this call reports echo, not speech, whenever it stays quiet during
+	 * playback. Local capture always needs it; remote capture needs it only
+	 * when that endpoint cancels no echo of its own.
+	 */
+	#echoGated(): boolean {
 		const outputActive = this.#outputLevel > OUTPUT_ACTIVE_LEVEL;
+		if (!outputActive) return false;
 		const echoThreshold = Math.max(MIN_BARGE_IN_LEVEL, this.#outputLevel * OUTPUT_ECHO_RATIO);
-		if (outputActive && this.#inputLevel < echoThreshold) return;
-		this.#sendInput(samples);
+		return this.#inputLevel < echoThreshold;
 	}
 
 	/**
-	 * Feeds externally captured microphone audio as mono 16 kHz PCM, for a
-	 * session whose endpoint is not the local machine.
+	 * Whether to apply the echo gate to {@link pushInput} frames.
 	 *
-	 * Unlike local capture this does not apply the echo gate: a remote endpoint
-	 * renders playback on its own device and cancels echo there, so gating on
-	 * this host's output level would only suppress genuine barge-in. Mute is
-	 * still honored.
+	 * Off by default: a remote endpoint normally cancels echo on its own
+	 * device, and gating on this host's output level would then only suppress
+	 * genuine barge-in. A guest that had to capture without echo cancellation
+	 * — the price of escaping the platform's communication output stream —
+	 * turns it on instead.
+	 */
+	setRemoteEchoGate(enabled: boolean): void {
+		this.#remoteEchoGate = enabled;
+	}
+
+	/**
+	 * Feeds externally captured microphone audio as mono 16 kHz PCM, for a
+	 * session whose endpoint is not the local machine. Mute is honored, and the
+	 * echo gate only when {@link setRemoteEchoGate} asked for it.
 	 */
 	pushInput(samples: Float32Array): void {
 		if (this.#stopped || !this.#transport || this.#muted || samples.length === 0) return;
 		this.#inputLevel = microphoneLevel(samples);
 		this.#emitLevels();
+		if (this.#remoteEchoGate && this.#echoGated()) return;
 		this.#sendInput(samples);
 	}
 
diff --git a/packages/coding-agent/src/modes/controllers/live-command-controller.ts b/packages/coding-agent/src/modes/controllers/live-command-controller.ts
index 0f2b945..33d4076 100644
--- a/packages/coding-agent/src/modes/controllers/live-command-controller.ts
+++ b/packages/coding-agent/src/modes/controllers/live-command-controller.ts
@@ -94,6 +94,7 @@ export class LiveCommandController {
 			},
 			pushInput: samples => this.#session?.pushInput(samples),
 			setMuted: muted => this.#session?.setMuted(muted),
+			setEchoGate: enabled => this.#session?.setRemoteEchoGate(enabled),
 			stop: () => this.stop(),
 		};
 	}
diff --git a/packages/wire/src/index.ts b/packages/wire/src/index.ts
index 861da12..3cf3431 100644
--- a/packages/wire/src/index.ts
+++ b/packages/wire/src/index.ts
@@ -345,11 +345,17 @@ export type GuestFrame =
 	 */
 	| { t: "live-audio"; pcm: string }
 	/**
-	 * Live-audio ownership and mute. `claim` starts a live session whose
-	 * endpoint is this guest (no host microphone or speaker) and fails when
-	 * another peer already owns it; `release` stops it.
+	 * Live-audio ownership, mute, and echo gating. `claim` starts a live
+	 * session whose endpoint is this guest (no host microphone or speaker) and
+	 * fails when another peer already owns it; `release` stops it.
+	 *
+	 * `gate-on` asks the host to apply its software echo gate to this guest's
+	 * input. A guest needs it when it captures without echo cancellation —
+	 * which it may have to do, because an echo-cancelling capture pins the
+	 * platform's output to its low-ceilinged communication stream. `gate-off`
+	 * is the default and the right choice when the guest cancels echo itself.
 	 */
-	| { t: "live-ctl"; op: "claim" | "release" | "mute" | "unmute" };
+	| { t: "live-ctl"; op: "claim" | "release" | "mute" | "unmute" | "gate-on" | "gate-off" };
 
 /** EventBus channels mirrored to guests (task subagent traffic only). */
 export type BusChannel = "task:subagent:progress" | "task:subagent:lifecycle";
