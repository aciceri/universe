+
+	async #handleLiveCtl(
+		op: "claim" | "release" | "mute" | "unmute" | "gate-on" | "gate-off",
+		fromPeer: number,
+	): Promise<void> {
+		const peer = this.#peers.get(fromPeer);
+		if (!peer?.canWrite) {
+			this.#rejectReadOnly("live audio", fromPeer);
+			return;
+		}
+		const bridge = this.#liveAudio;
+		if (!bridge) {
+			this.#send(
+				{ t: "live-state", active: false, error: "This host does not accept remote live audio." },
+				fromPeer,
+			);
+			return;
+		}
+		if (op === "claim") {
+			if (this.ending || this.#liveOwner === fromPeer) return;
+			if (this.#liveOwner !== undefined && this.#liveOwner !== fromPeer) {
+				const holder = this.#peers.get(this.#liveOwner)?.name ?? "another participant";
+				this.#send(
+					{
+						t: "live-state",
+						active: true,
+						owner: this.#liveOwner,
+						error: `${holder} is already holding live audio.`,
+					},
+					fromPeer,
+				);
+				return;
+			}
+			this.#liveOwner = fromPeer;
+			const generation = ++this.#liveGeneration;
+			const current = (): boolean => !this.ending && this.#liveGeneration === generation;
+			this.#liveSilent = true;
+			this.#liveMuted = false;
+			try {
+				await bridge.start({
+					onOutput: samples => {
+						if (current()) this.#sendLiveAudio(samples);
+					},
+					onTranscript: (role, text, turn, final) => {
+						if (current()) this.#send({ t: "live-transcript", role, text, turn, final }, fromPeer);
+					},
+					onPhase: phase => {
+						if (current()) this.#send({ t: "live-phase", phase }, fromPeer);
+					},
+					onTerminal: error => {
+						if (!current()) return;
+						this.#liveGeneration += 1;
+						this.#liveOwner = undefined;
+						this.#send({ t: "live-state", active: false, error: error?.message });
+					},
+				});
+			} catch (error) {
+				if (!current()) return;
+				this.#liveGeneration += 1;
+				this.#liveOwner = undefined;
+				this.#send({ t: "live-state", active: false, error: String(error) }, fromPeer);
+				return;
+			}
+			if (!current()) return;
+			this.#ctx.session.emitNotice("info", `${peer.name} started live voice`, "collab");
+			this.#send({ t: "live-state", active: true, owner: fromPeer, muted: this.#liveMuted });
+			return;
+		}
+		if (this.#liveOwner !== fromPeer) return;
+		if (op === "release") {
+			this.#liveOwner = undefined;
+			this.#liveGeneration += 1;
