 const WELCOME_IMAGE_STRIP_THRESHOLD = 24 * 1024 * 1024;
+/** Sample rate of the decoded live output stream forwarded to guests. */
+const LIVE_OUTPUT_RATE = 48_000;
+/** Frames whose peak stays at or below this are treated as silence. */
+const LIVE_SILENCE_PEAK = 0.002;
+
+/**
+ * Surface that owns live voice sessions on this host. The interactive `/live`
+ * controller registers one through {@link CollabHost.setLiveAudioBridge};
+ * without it, guests cannot start remote live audio.
+ */
+export interface CollabLiveAudioBridge {
+	/** Starts a live session with no local microphone or speaker. */
+	start(onOutput: (samples: Float32Array) => void): Promise<void>;
+	/** Feeds guest microphone audio as mono 16 kHz PCM. */
+	pushInput(samples: Float32Array): void;
+	setMuted(muted: boolean): void;
+	stop(): Promise<void>;
+}
+
+function decodePcm16(base64: string): Float32Array {
+	const bytes = Buffer.from(base64, "base64");
+	const count = bytes.byteLength >> 1;
+	const samples = new Float32Array(count);
+	for (let index = 0; index < count; index += 1) {
+		samples[index] = bytes.readInt16LE(index * 2) / 32_768;
+	}
+	return samples;
+}
+
+function encodePcm16(samples: Float32Array): string {
+	const bytes = Buffer.allocUnsafe(samples.length * 2);
+	for (let index = 0; index < samples.length; index += 1) {
+		const clamped = Math.max(-1, Math.min(1, samples[index] ?? 0));
+		bytes.writeInt16LE(Math.round(clamped * 32_767), index * 2);
+	}
+	return bytes.toString("base64");
+}
