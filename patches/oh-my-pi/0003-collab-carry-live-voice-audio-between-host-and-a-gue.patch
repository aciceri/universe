+/** Sample rate of the decoded live output stream forwarded to guests. */
+const LIVE_OUTPUT_RATE = 48_000;
+/** Frames whose peak stays at or below this are treated as silence. */
+const LIVE_SILENCE_PEAK = 0.002;
