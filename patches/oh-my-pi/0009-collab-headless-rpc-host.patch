+/**
+ * Mirror an RPC dialog to authenticated control guests. A transport loss is
+ * not a user cancellation: only an answer can win against the RPC client.
+ * The existing RPC dialog owns timeouts and abort handling on both surfaces.
+ */
+async function requestRpcCollabDialog<T>(
+	controller: CollabController | undefined,
+	request: CollabUiRequestDraft,
+	dialogOptions: ExtensionUIDialogOptions | undefined,
+	local: (options: ExtensionUIDialogOptions | undefined) => Promise<T>,
+	parseGuest: (value: string | undefined) => T,
+): Promise<T> {
+	const host = controller?.host;
+	if (!controller || !host || dialogOptions?.signal?.aborted) return local(dialogOptions);
+	const localAbort = new AbortController();
+	const remoteAbort = new AbortController();
+	const remoteSignal = dialogOptions?.signal
+		? AbortSignal.any([dialogOptions.signal, remoteAbort.signal])
+		: remoteAbort.signal;
+	const remote = host.requestGuestUi(request, remoteSignal);
+	if (!remote) return local(dialogOptions);
+	const releaseInputRequired = controller.beginInputRequired();
+	try {
+		const localResult = local({
+			...dialogOptions,
+			signal: dialogOptions?.signal ? AbortSignal.any([dialogOptions.signal, localAbort.signal]) : localAbort.signal,
+		});
+		return await Promise.race([
+			localResult,
+			remote.then(result => (result.kind === "answered" ? parseGuest(result.value) : localResult)),
+		]);
+	} finally {
+		localAbort.abort();
+		remoteAbort.abort();
+		releaseInputRequired();
+	}
+}
