index 0000000..959dffe
--- /dev/null
+++ b/packages/collab-client/upstream/src/lib/live-audio.ts
@@ -0,0 +1,311 @@
+/**
+ * Browser side of a remote live voice call.
+ *
+ * Captures the microphone, resamples to the 16 kHz mono PCM16 the host's
+ * realtime peer expects, and renders the host's 48 kHz output stream. Echo
+ * cancellation is left to the browser: the host deliberately skips its own
+ * echo gate for remote input, since the speaker is here, not there.
+ */
+
+const INPUT_RATE = 16_000;
+/** 20 ms at 16 kHz, matching the native peer's input framing. */
+const INPUT_FRAME = 320;
+/** Keep the playback queue this far ahead of the clock to absorb jitter. */
+const PLAYBACK_LEAD_S = 0.08;
+
+function encodePcm16(samples: Float32Array): string {
+	const bytes = new Uint8Array(samples.length * 2);
+	const view = new DataView(bytes.buffer);
+	for (let index = 0; index < samples.length; index += 1) {
+		const clamped = Math.max(-1, Math.min(1, samples[index] ?? 0));
+		view.setInt16(index * 2, Math.round(clamped * 32_767), true);
+	}
+	let binary = "";
+	for (const byte of bytes) binary += String.fromCharCode(byte);
+	return btoa(binary);
+}
+
+function decodePcm16(base64: string): Float32Array {
+	const binary = atob(base64);
+	const count = binary.length >> 1;
+	const samples = new Float32Array(count);
+	for (let index = 0; index < count; index += 1) {
+		const low = binary.charCodeAt(index * 2);
+		const high = binary.charCodeAt(index * 2 + 1);
+		const value = (high << 8) | low;
+		samples[index] = (value >= 0x8000 ? value - 0x10000 : value) / 32_768;
+	}
+	return samples;
+}
+
+/** Highest boost offered; past full saturation there is nothing left to gain. */
+export const MAX_GAIN = 32;
+
+/** Below this the curve is the identity, so a 1x setting is bit-transparent. */
+const SATURATION_KNEE = 0.7;
+
+/**
+ * Soft-clip transfer curve: identity up to {@link SATURATION_KNEE}, then a
+ * `tanh` shoulder that rounds peaks toward full scale instead of clipping
+ * into a square edge.
+ *
+ * A plain `tanh` over the whole range was wrong: it lifted and reshaped even
+ * a quiet signal, so the 1x setting already distorted instead of passing
+ * audio through. Only material driven past the knee is shaped now, which is
+ * exactly the material a boost creates.
+ */
+function saturationCurve(points: number): Float32Array {
+	const curve = new Float32Array(points);
+	const headroom = 1 - SATURATION_KNEE;
+	for (let index = 0; index < points; index += 1) {
+		const x = (index / (points - 1)) * 2 - 1;
+		const magnitude = Math.abs(x);
+		const shaped =
+			magnitude <= SATURATION_KNEE
+				? magnitude
+				: SATURATION_KNEE + headroom * Math.tanh((magnitude - SATURATION_KNEE) / headroom);
+		curve[index] = Math.sign(x) * shaped;
+	}
+	return curve;
+}
+
+/**
+ * Builds `gain → saturation → destination` and returns the input node.
+ *
+ * Exported so the chain can be rendered in an `OfflineAudioContext` and its
+ * output measured, which is the only way to check that a boost setting
+ * actually raises level rather than being swallowed downstream.
+ */
+export function createPlaybackChain(context: BaseAudioContext, gain: number): GainNode {
+	const gainNode = context.createGain();
+	gainNode.gain.value = gain;
+	const shaper = context.createWaveShaper();
+	const points = 4096;
+	const curve = new Float32Array(new ArrayBuffer(points * 4));
+	curve.set(saturationCurve(points));
+	shaper.curve = curve;
+	shaper.oversample = "4x";
+	gainNode.connect(shaper);
+	shaper.connect(context.destination);
+	return gainNode;
+}
+
+/** Capture options. `speaker` trades echo cancellation for output volume. */
+export interface CaptureOptions {
+	/** Pins an input; omitted, the browser follows the system default. */
+	deviceId?: string;
+	/** Drop echo cancellation so output leaves the communication stream. */
+	speaker?: boolean;
+}
+
+/** An audio input the browser is willing to open. */
+export interface AudioInput {
+	deviceId: string;
+	label: string;
+}
+
+/**
+ * Audio inputs, with human labels.
+ *
+ * Labels are empty until microphone permission has been granted at least once,
+ * so a device list built before the first successful `start()` is unnamed. That
+ * is why the picker only appears while a call is running.
+ */
+export async function listAudioInputs(): Promise<AudioInput[]> {
+	if (!navigator.mediaDevices?.enumerateDevices) return [];
+	const devices = await navigator.mediaDevices.enumerateDevices();
+	return devices
+		.filter(device => device.kind === "audioinput")
+		.map((device, index) => ({
+			deviceId: device.deviceId,
+			label: device.label || `microphone ${index + 1}`,
+		}));
+}
+
+/** One live call's microphone capture and speaker playback. */
+export class LiveAudioDevice {
+	readonly #onFrame: (pcm: string) => void;
+	#stream: MediaStream | undefined;
+	#context: AudioContext | undefined;
+	#node: ScriptProcessorNode | undefined;
+	#source: MediaStreamAudioSourceNode | undefined;
+	#pending: number[] = [];
+	#playbackContext: AudioContext | undefined;
+	#playbackCursor = 0;
+	#muted = false;
+	#deviceId: string | undefined;
+	#gainNode: GainNode | undefined;
+	#gain = 1;
+	#speaker = false;
+
+	constructor(onFrame: (pcm: string) => void) {
+		this.#onFrame = onFrame;
+	}
+
+	get active(): boolean {
+		return this.#stream !== undefined;
+	}
+
+	/** Whether the running capture dropped echo cancellation. */
+	get speaker(): boolean {
+		return this.#speaker;
+	}
+
+	/** Device the running capture was opened with, if it was pinned. */
+	get deviceId(): string | undefined {
+		return this.#deviceId;
+	}
+
+	/**
+	 * Reopens capture with new options; the call itself is untouched.
+	 *
+	 * Toggling `speaker` also rebuilds playback. Chrome decides an
+	 * AudioContext's output stream type when the context is constructed and
+	 * never revisits it, so a context created while an echo-cancelling capture
+	 * was live stays pinned to the platform's communication stream — reopening
+	 * only the microphone would leave output exactly as quiet as before. The
+	 * new context is therefore created lazily by the next `play()`, after the
+	 * cancellation-free capture is already running.
+	 *
+	 * A device that has disappeared makes `start` throw, so the caller
+	 * surfaces that the same way as a denied permission.
+	 */
+	async use(options: CaptureOptions): Promise<void> {
+		const speakerChanged = (options.speaker ?? false) !== this.#speaker;
+		this.#stopCapture();
+		if (speakerChanged) {
+			this.#gainNode = undefined;
+			this.#playbackCursor = 0;
+			const previous = this.#playbackContext;
+			this.#playbackContext = undefined;
+			await previous?.close().catch(() => {});
+		}
+		await this.start(options);
+	}
+
+	/**
+	 * @throws when the user denies microphone access or the device is gone.
+	 */
+	async start(options: CaptureOptions = {}): Promise<void> {
+		if (this.#stream) return;
+		const { deviceId, speaker = false } = options;
+		// `speaker`: an echo-cancelling capture makes Chrome pin output to the
+		// platform's communication stream, whose volume ceiling is low and not
+		// reachable from the page. Dropping cancellation returns output to the
+		// media stream — the host then applies its own software echo gate, so
+		// the assistant does not answer itself.
+		const stream = await navigator.mediaDevices.getUserMedia({
+			audio: {
+				...(deviceId ? { deviceId: { exact: deviceId } } : {}),
+				echoCancellation: !speaker,
+				noiseSuppression: !speaker,
+				autoGainControl: !speaker,
+				channelCount: 1,
+			},
+		});
+		this.#speaker = speaker;
+		this.#deviceId = deviceId;
+		this.#stream = stream;
+		const context = new AudioContext();
+		this.#context = context;
+		const source = context.createMediaStreamSource(stream);
+		this.#source = source;
+		// ScriptProcessor rather than an AudioWorklet: the worklet needs a
+		// separate module URL, and this path carries 20 ms frames of one mono
+		// channel, well inside its budget.
+		const node = context.createScriptProcessor(4096, 1, 1);
+		this.#node = node;
+		const ratio = context.sampleRate / INPUT_RATE;
+		node.onaudioprocess = event => {
+			if (this.#muted) return;
+			const input = event.inputBuffer.getChannelData(0);
+			for (let index = 0; index < Math.floor(input.length / ratio); index += 1) {
+				const position = index * ratio;
+				const low = Math.floor(position);
+				const high = Math.min(low + 1, input.length - 1);
+				const fraction = position - low;
+				this.#pending.push((input[low] ?? 0) * (1 - fraction) + (input[high] ?? 0) * fraction);
+			}
+			while (this.#pending.length >= INPUT_FRAME) {
+				this.#onFrame(encodePcm16(Float32Array.from(this.#pending.splice(0, INPUT_FRAME))));
+			}
+		};
+		source.connect(node);
+		// Chrome only pulls a ScriptProcessor that reaches the destination; a
+		// zero-gain sink keeps it running without echoing the microphone.
+		const sink = context.createGain();
+		sink.gain.value = 0;
+		node.connect(sink);
+		sink.connect(context.destination);
+	}
+
+	setMuted(muted: boolean): void {
+		this.#muted = muted;
+		for (const track of this.#stream?.getAudioTracks() ?? []) track.enabled = !muted;
+	}
+
+	/**
+	 * Playback boost.
+	 *
+	 * While an echo-cancelling capture is live, Chrome pins output to the
+	 * platform's communication stream so the hardware canceller gets its
+	 * reference signal. On Android that stream's ceiling is well below the
+	 * media one and the page cannot raise it — `speaker` mode escapes it by
+	 * dropping cancellation, and this gain is the lever that remains when you
+	 * stay on it.
+	 *
+	 * A previous version put a hard limiter after the gain, which capped the
+	 * output at roughly its threshold and made every setting above 2x sound
+	 * identical. The saturating curve below raises loudness instead: peaks
+	 * round off toward full scale rather than being flattened, so higher
+	 * settings keep getting louder until the signal is fully saturated.
+	 */
+	setPlaybackGain(gain: number): void {
+		this.#gain = Math.max(1, Math.min(MAX_GAIN, gain));
+		if (this.#gainNode) this.#gainNode.gain.value = this.#gain;
+	}
+
+	/** Queues one decoded host frame for playback in arrival order. */
+	play(pcm: string, rate: number): void {
+		const samples = decodePcm16(pcm);
+		if (samples.length === 0) return;
+		const context = (this.#playbackContext ??= new AudioContext());
+		void context.resume();
+		this.#gainNode ??= createPlaybackChain(context, this.#gain);
+		const buffer = context.createBuffer(1, samples.length, rate);
+		buffer.getChannelData(0).set(samples);
+		const source = context.createBufferSource();
+		source.buffer = buffer;
+		source.connect(this.#gainNode);
+		const earliest = context.currentTime + PLAYBACK_LEAD_S;
+		const startAt = Math.max(this.#playbackCursor, earliest);
+		source.start(startAt);
+		this.#playbackCursor = startAt + buffer.duration;
+	}
+
+	/**
+	 * Tears down capture only. The capture AudioContext is closed without
+	 * awaiting: `use()` opens the replacement immediately, and a pending close
+	 * on the old context does not block the new one.
+	 */
+	#stopCapture(): void {
+		this.#node?.disconnect();
+		this.#source?.disconnect();
+		for (const track of this.#stream?.getAudioTracks() ?? []) track.stop();
+		void this.#context?.close().catch(() => {});
+		this.#stream = undefined;
+		this.#node = undefined;
+		this.#source = undefined;
+		this.#context = undefined;
+		this.#pending = [];
+	}
+
+	async stop(): Promise<void> {
+		this.#stopCapture();
+		this.#deviceId = undefined;
+		this.#playbackCursor = 0;
+		await this.#playbackContext?.close().catch(() => {});
+		this.#playbackContext = undefined;
+		this.#gainNode = undefined;
+	}
+}
diff --git a/packages/collab-client/upstream/src/lib/live-frames.ts b/packages/collab-client/upstream/src/lib/live-frames.ts
new file mode 100644
index 0000000..0f7b792
--- /dev/null
+++ b/packages/collab-client/upstream/src/lib/live-frames.ts
@@ -0,0 +1,30 @@
+/**
+ * Host frames for remote live voice, declared locally.
+ *
+ * The vendored client pins `@oh-my-pi/pi-wire` at `18.1.14`, whose `HostFrame`
+ * union predates these frames, and a union cannot be extended by declaration
+ * merging. The client therefore narrows them itself from the raw frame before
+ * the pinned union's `switch` sees it; the shapes mirror the host exactly.
+ */
+export type LiveHostFrame =
+	| { t: "live-state"; active: boolean; owner?: number; muted?: boolean; error?: string }
+	| { t: "live-transcript"; role: "user" | "assistant"; text: string; turn: number; final: boolean }
+	| { t: "live-phase"; phase: string }
+	| { t: "live-out"; pcm: string; rate: number };
+
+/** Guest frames for remote live voice, absent from the pinned wire union. */
+export type LiveGuestFrame =
+	| { t: "live-audio"; pcm: string }
+	| { t: "live-ctl"; op: "claim" | "release" | "mute" | "unmute" | "gate-on" | "gate-off" };
+
+const LIVE_FRAME_TAGS: Record<string, true> = {
+	"live-state": true,
+	"live-transcript": true,
+	"live-phase": true,
+	"live-out": true,
+};
+
+/** Narrows a raw host frame to a live frame, or returns undefined. */
+export function asLiveFrame(frame: { t: string }): LiveHostFrame | undefined {
+	return LIVE_FRAME_TAGS[frame.t] === true ? (frame as LiveHostFrame) : undefined;
+}
