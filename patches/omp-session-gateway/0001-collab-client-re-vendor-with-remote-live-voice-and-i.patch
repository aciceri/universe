@@ -282,6 +314,121 @@ export function Session({ client, onLeave, onRejoin, embedOptions }: SessionProp
 		document.title = `${title} · omp collab`;
 	}, [title]);
 
+	// Live voice: the host runs the realtime call, this device is its
+	// microphone and speaker. Playback is wired before any claim so the first
+	// frame after `live-state` is not dropped.
+	const audioRef = useRef<LiveAudioDevice | null>(null);
+	const [liveError, setLiveError] = useState<string | null>(null);
+	const [gain, setGain] = useState<number>(() => storedGain());
+	useEffect(() => {
+		const device = new LiveAudioDevice(pcm => client.sendLiveAudio(pcm));
+		// Read from storage, not from state: this effect is keyed on `client`
+		// only, and later changes go through `pickGain` directly.
+		device.setPlaybackGain(storedGain());
+		audioRef.current = device;
+		client.onLiveAudio = (pcm, rate) => device.play(pcm, rate);
+		return () => {
+			client.onLiveAudio = undefined;
+			audioRef.current = null;
+			void device.stop();
+		};
+	}, [client]);
+
+	// Pinned input, remembered across calls. An empty stored value means
+	// "follow the system default", which is also what an unknown device falls
+	// back to once `start` rejects it.
+	const [inputId, setInputId] = useState<string | undefined>(() => storedMic());
+	const [inputs, setInputs] = useState<readonly AudioInput[]>([]);
+	const [speaker, setSpeaker] = useState<boolean>(() => {
+		try {
+			return localStorage.getItem(SPEAKER_KEY) === "1";
+		} catch {
+			return false;
+		}
+	});
+
+	const owned = snap.live.owned;
+	useEffect(() => {
+		const device = audioRef.current;
+		if (!device) return;
+		if (owned && !device.active) {
+			device
+				.start({ deviceId: inputId, speaker })
+				// The host defaults the gate off, so a persisted speaker mode has to
+				// re-assert it on every claim.
+				.then(() => client.setLiveEchoGate(speaker))
+				// Labels are blank until permission is granted, so the list is
+				// only worth reading once capture is actually running.
+				.then(() => listAudioInputs().then(setInputs))
+				.catch((err: unknown) => {
+					setLiveError(err instanceof Error ? err.message : String(err));
+					client.stopLiveAudio();
+				});
+		} else if (!owned && device.active) {
+			void device.stop();
+			setInputs([]);
+		}
+		// `inputId` intentionally absent: switching device while running is
+		// handled by `pickInput`, not by tearing down and restarting the call.
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, [owned, client]);
+	useEffect(() => {
+		audioRef.current?.setMuted(snap.live.muted);
+	}, [snap.live.muted]);
+
+	const pickInput = useCallback(
+		(deviceId: string | undefined) => {
+			setInputId(deviceId);
+			storeMic(deviceId);
+			setLiveError(null);
+			const device = audioRef.current;
+			if (!device?.active) return;
+			device.use({ deviceId, speaker }).catch((err: unknown) => {
+				setLiveError(err instanceof Error ? err.message : String(err));
+				client.stopLiveAudio();
+			});
+		},
+		[client],
+	);
+
+	const toggleSpeaker = useCallback(
+		(next: boolean) => {
+			setSpeaker(next);
+			try {
+				localStorage.setItem(SPEAKER_KEY, next ? "1" : "0");
+			} catch {
+				// Persistence is best-effort; the in-memory choice still applies.
+			}
+			// Without local cancellation the host has to gate the echo, so tell
+			// it before the microphone is reopened on the louder route.
+			client.setLiveEchoGate(next);
+			setLiveError(null);
+			const device = audioRef.current;
+			if (!device?.active) return;
+			device.use({ deviceId: inputId, speaker: next }).catch((err: unknown) => {
+				setLiveError(err instanceof Error ? err.message : String(err));
+				client.stopLiveAudio();
+			});
+		},
+		[client, inputId],
+	);
+
+	const pickGain = useCallback((next: number) => {
+		setGain(next);
+		try {
+			localStorage.setItem(GAIN_KEY, String(next));
+		} catch {
+			// Persistence is best-effort; the in-memory boost still applies.
+		}
+		audioRef.current?.setPlaybackGain(next);
+	}, []);
+
+	const toggleLive = useCallback(() => {
+		setLiveError(null);
+		if (snap.live.owned) client.stopLiveAudio();
+		else if (!snap.live.active) client.startLiveAudio();
+	}, [client, snap.live.owned, snap.live.active]);
+
 	const drawerAgent = selectedId != null ? snap.agents.find(a => a.id === selectedId) : undefined;
 
 	return (
@@ -293,6 +440,8 @@ export function Session({ client, onLeave, onRejoin, embedOptions }: SessionProp
