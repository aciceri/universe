+import { Type } from "lucide-react";
+import { UI_SCALES, useUiScale } from "../../lib/ui-scale";
+
+export function ScaleToggle() {
+	const { scale, setScale } = useUiScale();
+	const percent = Math.round(scale * 100);
+
+	return (
+		<button
+			type="button"
+			className="sh-theme-toggle sh-scale-toggle"
+			onClick={() => setScale(UI_SCALES[(UI_SCALES.indexOf(scale) + 1) % UI_SCALES.length]!)}
+			aria-label={`Interface scale ${percent}% (click to change)`}
+			title={`Interface scale ${percent}% — click to change`}
+		>
+			<Type size={14} />
+			<span className="sh-scale-value">{percent}</span>
+		</button>
+	);
+}
