+/// Render one decoded frame: local speaker when present, the host output tap
+/// when installed, and the RMS level window either way. Returns `false` once
+/// playback has failed terminally.
+fn emit_output(
+	playback_tx: Option<&PlaybackWriter>,
+	samples: &[f32],
+	core: &Weak<LivePeerCore>,
+	level: &mut OutputLevel,
+) -> bool {
+	if let Some(playback_tx) = playback_tx
+		&& let Err(error) = playback_tx.write(samples)
+	{
+		if let Some(core) = core.upgrade()
+			&& !core.closing.load(Ordering::Acquire)
+		{
+			core.report_failure(format!("Live speaker playback failed: {error}"));
+		}
+		return false;
+	}
+	if let Some(core) = core.upgrade() {
+		core.report_output(samples);
 	}
+	level.observe(samples, core);
+	true
 }
 
