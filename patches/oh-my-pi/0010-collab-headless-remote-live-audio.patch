@@ -0,0 +1,122 @@
+import type { CollabLiveAudioBridge, CollabLiveSinks } from "../../collab/host";
+import { extractTextContent } from "../../commit/utils";
+import { LiveSessionController } from "../../live/controller";
+import type { AgentSession } from "../../session/agent-session";
+
+interface RemoteCall {
+	controller: LiveSessionController;
+	abort: AbortController;
+	sinks: CollabLiveSinks;
+	starting?: Promise<void>;
+	stopping?: Promise<void>;
+	connected: boolean;
+	closing: boolean;
+	failure?: Error;
+}
+
+/** Owns remote voice without creating terminal UI or opening local audio devices. */
+export class RpcLiveAudioBridge implements CollabLiveAudioBridge {
+	#call: RemoteCall | undefined;
+	#disposed = false;
+
+	constructor(
+		readonly session: AgentSession,
+		readonly reportError: (error: Error) => void,
+	) {}
+
+	async start(sinks: CollabLiveSinks): Promise<void> {
+		if (this.#disposed) throw new Error("The RPC live audio bridge has been disposed.");
+		if (this.#call) throw new Error("A live session is already running or stopping on the host.");
+		const abort = new AbortController();
+		const current = (): boolean => this.#call === call && !call.closing;
+		const controller = new LiveSessionController({
+			session: this.session,
+			extractAssistantText: extractTextContent,
+			voice: this.session.settings.get("live.voice"),
+			signal: abort.signal,
+			audio: {
+				localCapture: false,
+				localPlayback: false,
+				onOutput: samples => {
+					if (current()) sinks.onOutput(samples);
+				},
+			},
+			callbacks: {
+				onPhase: phase => {
+					if (current()) sinks.onPhase(phase);
+				},
+				onTranscript: transcript => {
+					if (current() && transcript) {
+						sinks.onTranscript(transcript.role, transcript.text, transcript.turn, transcript.final);
+					}
+				},
+				onTerminal: error => {
+					if (!current()) {
+						if (this.#call === call && call.connected) call.failure ??= error;
+						return;
+					}
+					call.failure = error;
+					void this.#stop(call);
+				},
+			},
+		});
+		const call: RemoteCall = { controller, abort, sinks, connected: false, closing: false };
+		this.#call = call;
+		call.starting = controller.start();
+		try {
+			await call.starting;
+			if (!current()) throw call.failure ?? new Error("The live session stopped while starting.");
+			call.connected = true;
+		} catch (cause) {
+			if (!call.closing) call.failure = cause instanceof Error ? cause : new Error(String(cause));
+			await this.#stop(call);
+			throw cause;
+		}
+	}
+
+	pushInput(samples: Float32Array): void {
+		if (this.#call && !this.#call.closing) this.#call.controller.pushInput(samples);
+	}
+
+	setMuted(muted: boolean): void {
+		if (this.#call && !this.#call.closing) this.#call.controller.setMuted(muted);
+	}
+
+	setEchoGate(enabled: boolean): void {
+		if (this.#call && !this.#call.closing) this.#call.controller.setRemoteEchoGate(enabled);
+	}
+
+	stop(): Promise<void> {
+		return this.#call ? this.#stop(this.#call) : Promise.resolve();
+	}
+
+	dispose(): Promise<void> {
+		this.#disposed = true;
+		return this.stop();
+	}
+
+	#stop(call: RemoteCall): Promise<void> {
+		if (call.stopping) return call.stopping;
+		call.closing = true;
+		// Abort signaling and an unopened sideband, not a connected call's graceful close.
+		if (!call.connected) call.abort.abort();
+		// Defer cleanup so synchronous terminal callbacks cannot reenter before stopping is assigned.
+		call.stopping = Promise.resolve().then(async () => {
+			try {
+				await call.controller.stop();
+			} catch (cause) {
+				call.failure ??= cause instanceof Error ? cause : new Error(String(cause));
+			} finally {
+				// A late connect continuation must settle before another call or session can start.
+				await call.starting?.catch(() => {});
+				if (this.#call === call) this.#call = undefined;
+				if (call.failure) {
+					this.session.emitNotice("error", `Live voice failed: ${call.failure.message}`, "live");
+					this.reportError(call.failure);
+				}
+				call.sinks.onTerminal?.(call.failure);
+			}
+		});
+		return call.stopping;
+	}
+}
