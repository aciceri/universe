diff --git a/packages/coding-agent/test/collab/live-audio.test.ts b/packages/coding-agent/test/collab/live-audio.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/collab/live-audio.test.ts
@@ -0,0 +1,221 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import { importRoomKey } from "@oh-my-pi/pi-coding-agent/collab/crypto";
+import {
+	CollabHost,
+	type CollabHostContext,
+	type CollabLiveAudioBridge,
+	type CollabLiveSinks,
+} from "@oh-my-pi/pi-coding-agent/collab/host";
+import { COLLAB_PROTO, type CollabFrame, parseCollabLink } from "@oh-my-pi/pi-coding-agent/collab/protocol";
+import { CollabSocket } from "@oh-my-pi/pi-coding-agent/collab/relay-client";
+import { installInMemoryRelay, uninstallInMemoryRelay } from "./helpers/in-memory-relay";
+
+/** Delayed connection and close let real encrypted guest traffic cross lifecycle boundaries. */
+class DelayedAudio implements CollabLiveAudioBridge {
+	calls: Array<{ sinks: CollabLiveSinks; connection: PromiseWithResolvers<void> }> = [];
+	active = false;
+	closed = Promise.withResolvers<void>();
+	closeGate = Promise.resolve();
+	muted = false;
+	gate = false;
+
+	start(sinks: CollabLiveSinks): Promise<void> {
+		if (this.active) return Promise.reject(new Error("A call is already active"));
+		this.active = true;
+		const connection = Promise.withResolvers<void>();
+		this.calls.push({ sinks, connection });
+		return connection.promise;
+	}
+	pushInput(samples: Float32Array): void {
+		if (!this.muted) this.calls.at(-1)?.sinks.onOutput(samples);
+	}
+	setMuted(muted: boolean): void {
+		this.muted = muted;
+	}
+	setEchoGate(enabled: boolean): void {
+		this.gate = enabled;
+	}
+	async stop(): Promise<void> {
+		this.active = false;
+		this.closed.resolve();
+		await this.closeGate;
+	}
+}
+
+type HealthFrame = { t: "gateway-health-ping" | "gateway-health-pong"; seq: number };
+interface Guest {
+	socket: CollabSocket;
+	frames: CollabFrame[];
+	flush(): Promise<void>;
+}
+
+const guests: Guest[] = [];
+let host: CollabHost;
+let audio: DelayedAudio;
+const notices: string[] = [];
+
+async function join(link: string, name: string): Promise<Guest> {
+	const parsed = parseCollabLink(link);
+	if ("error" in parsed) throw new Error(parsed.error);
+	const socket = new CollabSocket({ wsUrl: parsed.wsUrl, role: "guest", key: await importRoomKey(parsed.key) });
+	const frames: CollabFrame[] = [];
+	const welcome = Promise.withResolvers<void>();
+	const barriers = new Map<number, () => void>();
+	let seq = 0;
+	socket.onFrame = raw => {
+		const frame = raw as CollabFrame | HealthFrame;
+		if (frame.t === "gateway-health-pong") barriers.get(frame.seq)?.();
+		else if (frame.t === "welcome") welcome.resolve();
+		else if (frame.t.startsWith("live-")) frames.push(frame as CollabFrame);
+	};
+	socket.onOpen = () =>
+		socket.send({
+			t: "hello",
+			proto: COLLAB_PROTO,
+			name,
+			writeToken: parsed.writeToken ? Buffer.from(parsed.writeToken).toString("base64url") : undefined,
+		});
+	socket.connect();
+	const guest: Guest = {
+		socket,
+		frames,
+		async flush() {
+			const id = ++seq;
+			const barrier = Promise.withResolvers<void>();
+			barriers.set(id, barrier.resolve);
+			socket.send({ t: "gateway-health-ping", seq: id } as unknown as CollabFrame);
+			await barrier.promise;
+			barriers.delete(id);
+		},
+	};
+	guests.push(guest);
+	await welcome.promise;
+	return guest;
+}
+
+beforeEach(async () => {
+	installInMemoryRelay();
+	notices.length = 0;
+	const ctx = {
+		settings: { get: () => "" },
+		sessionManager: {
+			getSessionId: () => "live-session",
+			getCwd: () => "/tmp",
+			snapshotForReplication: () => ({
+				header: { type: "session", id: "live-session", timestamp: "2026-01-01T00:00:00.000Z", cwd: "/tmp" },
+				entries: [],
+			}),
+		},
+		session: {
+			isStreaming: false,
+			queuedMessageCount: 0,
+			sessionName: "live",
+			subscribe: () => () => {},
+			emitNotice: (_level: string, message: string) => notices.push(message),
+			getContextBreakdown: () => ({ usedTokens: 0, contextWindow: 0 }),
+		},
+		showStatus: (message: string) => notices.push(message),
+	} as unknown as CollabHostContext;
+	audio = new DelayedAudio();
+	host = new CollabHost(ctx);
+	host.setLiveAudioBridge(audio);
+	await host.start("ws://localhost:8787");
+});
+
+afterEach(async () => {
+	for (const call of audio.calls) call.connection.resolve();
+	for (const guest of guests.splice(0)) guest.socket.close();
+	try {
+		await host.stop("test complete");
+	} finally {
+		uninstallInMemoryRelay();
+	}
+});
+
+describe("collab live audio ownership", () => {
+	it("keeps a duplicate claimant's ownership and a mute set while connecting", async () => {
+		const guest = await join(host.link, "speaker");
+		guest.socket.send({ t: "live-ctl", op: "claim" });
+		await guest.flush();
+		guest.socket.send({ t: "live-ctl", op: "claim" });
+		guest.socket.send({ t: "live-ctl", op: "mute" });
+		await guest.flush();
+		expect(guest.frames).toEqual([{ t: "live-state", active: true, owner: 1, muted: true }]);
