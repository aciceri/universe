+	/**
+	 * Registers the surface that owns live sessions on this host, normally the
+	 * interactive `/live` controller. Absent, `live-ctl` is refused.
+	 */
+	setLiveAudioBridge(bridge: CollabLiveAudioBridge | undefined): void {
+		this.#liveAudio = bridge;
+	}
+
+	async #handleLiveCtl(op: "claim" | "release" | "mute" | "unmute", fromPeer: number): Promise<void> {
+		const peer = this.#peers.get(fromPeer);
+		if (!peer?.canWrite) {
+			this.#rejectReadOnly("live audio", fromPeer);
+			return;
+		}
+		const bridge = this.#liveAudio;
+		if (!bridge) {
+			this.#socket?.send({ t: "live-state", active: false, error: "This host does not accept remote live audio." }, fromPeer);
+			return;
+		}
+		if (op === "claim") {
+			if (this.#liveOwner !== undefined && this.#liveOwner !== fromPeer) {
+				const holder = this.#peers.get(this.#liveOwner)?.name ?? "another participant";
+				this.#socket?.send(
+					{ t: "live-state", active: true, owner: this.#liveOwner, error: `${holder} is already holding live audio.` },
+					fromPeer,
+				);
+				return;
+			}
+			this.#liveOwner = fromPeer;
+			try {
+				await bridge.start(samples => this.#sendLiveAudio(samples));
+			} catch (error) {
+				this.#liveOwner = undefined;
+				this.#socket?.send({ t: "live-state", active: false, error: String(error) }, fromPeer);
+				return;
+			}
+			this.#ctx.session.emitNotice("info", `${peer.name} started live voice`, "collab");
+			this.#broadcast({ t: "live-state", active: true, owner: fromPeer, muted: false });
+			return;
+		}
+		if (this.#liveOwner !== fromPeer) return;
+		if (op === "release") {
+			this.#liveOwner = undefined;
+			await bridge.stop().catch(error => logger.warn("collab live stop failed", { error: String(error) }));
+			this.#ctx.session.emitNotice("info", `${peer.name} stopped live voice`, "collab");
+			this.#broadcast({ t: "live-state", active: false });
+			return;
+		}
+		const muted = op === "mute";
+		bridge.setMuted(muted);
+		this.#broadcast({ t: "live-state", active: true, owner: fromPeer, muted });
+	}
+
+	#handleLiveAudio(pcm: string, fromPeer: number): void {
+		if (this.#liveOwner !== fromPeer || !this.#liveAudio) return;
+		const samples = decodePcm16(pcm);
+		if (samples.length > 0) this.#liveAudio.pushInput(samples);
+	}
+
+	/**
+	 * Forwards one decoded output frame to the owning guest. Silent frames are
+	 * dropped: the remote track runs for the whole call, and in practice almost
+	 * all of it is silence, so relaying it verbatim would waste bandwidth for
+	 * nothing.
+	 */
+	#sendLiveAudio(samples: Float32Array): void {
+		const owner = this.#liveOwner;
+		if (owner === undefined || !this.#socket) return;
+		let peak = 0;
+		for (const sample of samples) {
+			const magnitude = Math.abs(sample);
+			if (magnitude > peak) peak = magnitude;
+		}
+		if (peak <= LIVE_SILENCE_PEAK) {
+			// One frame of hangover keeps word-final consonants from clipping.
+			if (this.#liveSilent) return;
+			this.#liveSilent = true;
+		} else {
+			this.#liveSilent = false;
+		}
+		this.#socket.send({ t: "live-out", pcm: encodePcm16(samples), rate: LIVE_OUTPUT_RATE }, owner);
+	}
+
 	#handlePeerLeft(peer: number): void {
 		const name = this.#peers.get(peer)?.name;
 		this.#peers.delete(peer);
+		if (this.#liveOwner === peer) {
+			this.#liveOwner = undefined;
+			const bridge = this.#liveAudio;
+			void bridge?.stop().catch(error => logger.warn("collab live stop failed", { error: String(error) }));
+			this.#broadcast({ t: "live-state", active: false });
+		}
 		if (name) this.#ctx.session.emitNotice("info", `${name} left the collab session`, "collab");
 		this.#updateStatusSegment();
 		this.#scheduleStateBroadcast();
