+/** Delayed connection and close let real encrypted guest traffic cross lifecycle boundaries. */
+class DelayedAudio implements CollabLiveAudioBridge {
+	calls: Array<{ sinks: CollabLiveSinks; connection: PromiseWithResolvers<void> }> = [];
+	active = false;
+	closed = Promise.withResolvers<void>();
+	closeGate = Promise.resolve();
+	muted = false;
+	gate = false;
+
+	start(sinks: CollabLiveSinks): Promise<void> {
+		if (this.active) return Promise.reject(new Error("A call is already active"));
+		this.active = true;
+		const connection = Promise.withResolvers<void>();
+		this.calls.push({ sinks, connection });
+		return connection.promise;
+	}
+	pushInput(samples: Float32Array): void {
+		if (!this.muted) this.calls.at(-1)?.sinks.onOutput(samples);
+	}
+	setMuted(muted: boolean): void {
+		this.muted = muted;
+	}
+	setEchoGate(enabled: boolean): void {
+		this.gate = enabled;
+	}
+	async stop(): Promise<void> {
+		this.active = false;
+		this.closed.resolve();
+		await this.closeGate;
+	}
+}
+
+interface Guest {
+	socket: CollabSocket;
+	frames: CollabFrame[];
+	flush(): Promise<void>;
+}
+
+const guests: Guest[] = [];
+let host: CollabHost;
+let audio: DelayedAudio;
+const notices: string[] = [];
+let tmp: string;
+let publishSpy: Mock<typeof registry.publishCollabHost>;
+
+async function join(link: string, name: string): Promise<Guest> {
+	const parsed = parseCollabLink(link);
+	if ("error" in parsed) throw new Error(parsed.error);
+	const socket = new CollabSocket({ wsUrl: parsed.wsUrl, role: "guest", key: await importRoomKey(parsed.key) });
+	const frames: CollabFrame[] = [];
+	const welcome = Promise.withResolvers<void>();
+	const barriers = new Map<number, () => void>();
+	let seq = 0;
+	socket.onFrame = frame => {
+		if (frame.t === "transcript") barriers.get(frame.reqId)?.();
+		else if (frame.t === "welcome") welcome.resolve();
+		else if (frame.t.startsWith("live-")) frames.push(frame);
+	};
+	socket.onOpen = () =>
+		socket.send({
+			t: "hello",
+			proto: COLLAB_PROTO,
+			name,
+			writeToken: parsed.writeToken ? Buffer.from(parsed.writeToken).toString("base64url") : undefined,
+		});
+	socket.connect();
+	const guest: Guest = {
+		socket,
+		frames,
+		async flush() {
+			const id = ++seq;
+			const barrier = Promise.withResolvers<void>();
+			barriers.set(id, barrier.resolve);
+			// A missing transcript replies synchronously after preceding inbound
+			// frames, replacing the old gateway fork's health-ping barrier.
+			socket.send({ t: "fetch-transcript", reqId: id, agentId: "live-audio-barrier", fromByte: 0 });
+			await barrier.promise;
+			barriers.delete(id);
+		},
+	};
+	guests.push(guest);
+	await welcome.promise;
+	return guest;
+}
