@@ -0,0 +1,156 @@
+import { Mic, MicOff, Radio, Volume1, Volume2 } from "lucide-react";
+import type { ReactNode } from "react";
+import type { GuestSnapshot } from "../../lib/client";
+import type { AudioInput } from "../../lib/live-audio";
+
+export interface LivePanelProps {
+	live: GuestSnapshot["live"];
+	onToggleMute(): void;
+	onStop(): void;
+	/**
+	 * Starts a call from the panel itself. Set only when no header is mounted
+	 * to hold the control — embedded gateway mode suppresses it — so the panel
+	 * is then the sole entry point rather than a duplicate of the header one.
+	 */
+	onStart?(): void;
+	/** Local microphone failure (permission denied, no device). */
+	error?: string | null;
+	/** Available audio inputs; rendered as a picker only when there are two or more. */
+	inputs?: readonly AudioInput[];
+	/** Pinned input, or undefined while following the system default. */
+	inputId?: string;
+	onPickInput?(deviceId: string | undefined): void;
+	/**
+	 * Playback boost, 1 to 8. Needed because an active capture forces output
+	 * onto the platform's communication stream, whose ceiling is lower.
+	 */
+	gain?: number;
+	onPickGain?(gain: number): void;
+	/**
+	 * Speaker mode: capture without echo cancellation so output leaves the
+	 * platform's quiet communication stream. The host gates the echo instead.
+	 */
+	speaker?: boolean;
+	onToggleSpeaker?(enabled: boolean): void;
+}
+
+/**
+ * Realtime voice overlay.
+ *
+ * Deliberately not part of the session transcript: these lines are speech
+ * recognition of the live call, they rewrite themselves while a turn streams,
+ * and they are never persisted in the session. Rendering them inline would
+ * mix volatile recognition with the durable transcript.
+ */
+export function LivePanel({
+	live,
+	onToggleMute,
+	onStop,
+	onStart,
+	error,
+	inputs,
+	inputId,
+	onPickInput,
+	gain = 1,
+	onPickGain,
+	speaker = false,
+	onToggleSpeaker,
+}: LivePanelProps): ReactNode {
+	if (!live.owned) {
+		if (!onStart) return null;
+		const held = live.active;
+		// A failed start releases the call, so `owned` goes false and this idle
+		// row is where the reason has to be readable. It cannot live in a title
+		// attribute: on a phone there is nothing to hover.
+		const failure = error ?? live.error;
+		return (
+			<aside className="sh-live sh-live-idle" aria-label="live voice">
+				<button type="button" className="sh-live-start" onClick={onStart} disabled={held}>
+					<MicOff size={12} />
+					<span>{held ? "live voice held by another participant" : "start live voice"}</span>
+				</button>
+				{failure && <p className="sh-live-failure">{failure}</p>}
+			</aside>
+		);
+	}
+	const phase = live.error ?? error ?? live.phase ?? "connecting";
+	return (
+		<aside className="sh-live" aria-label="live voice">
+			<header className="sh-live-head">
+				<Radio size={12} className={live.phase === "speaking" ? "sh-live-on" : undefined} />
+				<span className="sh-live-title">live voice</span>
+				<span className={`sh-live-phase sh-live-phase-${live.phase ?? "connecting"}`}>{phase}</span>
+				{onPickInput && inputs && inputs.length > 1 && (
+					<select
+						className="sh-live-input"
+						value={inputId ?? ""}
+						onChange={event => onPickInput(event.target.value || undefined)}
+						title="microphone"
+					>
+						<option value="">system default</option>
+						{inputs.map(input => (
+							<option key={input.deviceId} value={input.deviceId}>
+								{input.label}
+							</option>
+						))}
+					</select>
+				)}
+				{onToggleSpeaker && (
+					<button
+						type="button"
+						className={speaker ? "sh-btn sh-btn-icon sh-btn-on" : "sh-btn sh-btn-icon"}
+						onClick={() => onToggleSpeaker(!speaker)}
+						title={
+							speaker
+								? "loud output, host-side echo gating — tap for echo cancellation"
+								: "quiet call-stream output with echo cancellation — tap for loud output"
+						}
+					>
+						{speaker ? <Volume2 size={12} /> : <Volume1 size={12} />}
+					</button>
+				)}
+				{onPickGain && (
+					<select
+						className="sh-live-input"
+						value={String(gain)}
+						onChange={event => onPickGain(Number(event.target.value))}
+						title="playback boost — an active microphone forces output onto the call stream, which is quieter"
+					>
+						{[1, 2, 4, 8, 16, 32].map(step => (
+							<option key={step} value={step}>
+								{step}×
+							</option>
+						))}
+					</select>
+				)}
+				<button
+					type="button"
+					className="sh-btn sh-btn-icon"
+					onClick={onToggleMute}
+					title={live.muted ? "unmute microphone" : "mute microphone"}
+				>
+					{live.muted ? <MicOff size={12} /> : <Mic size={12} />}
+				</button>
+				<button type="button" className="sh-btn sh-btn-icon" onClick={onStop} title="end live voice">
+					end
+				</button>
+			</header>
+			<div className="sh-live-lines">
+				<p className="sh-live-line sh-live-you">
+					<span className="sh-live-who">you</span>
+					<span className={live.transcript.user?.final === false ? "sh-live-text sh-live-partial" : "sh-live-text"}>
+						{live.transcript.user?.text || (live.muted ? "microphone muted" : "listening…")}
+					</span>
+				</p>
+				<p className="sh-live-line sh-live-agent">
+					<span className="sh-live-who">omp</span>
+					<span
+						className={live.transcript.assistant?.final === false ? "sh-live-text sh-live-partial" : "sh-live-text"}
+					>
+						{live.transcript.assistant?.text || "—"}
+					</span>
+				</p>
+			</div>
+		</aside>
+	);
+}
